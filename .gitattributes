# LF in the repository and the working tree, so hooks and scripts run the same on Windows and in CI.
# This machine has core.autocrlf=true at system level; these rules win over it.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries: never normalised or diffed
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.jar  binary
*.apk  binary
*.aab  binary
*.zip  binary
