# Gabay — .env.example
# Version 0.1 stub · 2026-10-07 · Phase 0 stub (standard §2; plan.html L115)
# Copy to .env and fill in. The real .env is never committed (the pre-commit hook refuses it, §8.1).
# Keys are added here in the same change that first reads them. Today only the local database exists.

# ---------------------------------------------------------------------------
# Local PostgreSQL (L109, L115). Development only.
# ---------------------------------------------------------------------------
# Host of the local PostgreSQL 18 server.
PGHOST=localhost
# Port (the installer's default).
PGPORT=5432
# Database created in INSTALL.md A.1.
PGDATABASE=gabay_dev
# Superuser for local development only. The API gets its own least-privilege login in Phase 1.
PGUSER=postgres
# The password you chose at install. Never commit a real value.
PGPASSWORD=

# ---------------------------------------------------------------------------
# Test accounts (L119). Local Firebase Auth emulator only. One password per account; never commit real values.
# ---------------------------------------------------------------------------
# superadmin@gabay.test: SuperAdmin (platform).
SEED_PW_SUPERADMIN=
# malladmin@gabay.test: Mall admin of both test tenants (the product owner).
SEED_PW_MALLADMIN=
# editor@gabay.test: Venue editor, both tenants.
SEED_PW_EDITOR=
# viewer@gabay.test: Viewer, both tenants.
SEED_PW_VIEWER=
# malladmin.demo@gabay.test: Mall admin of Demo Malls only (tenant isolation).
SEED_PW_MALLADMIN_DEMO=
# shopper@gabay.test: a signed-in shopper.
SEED_PW_SHOPPER=

# ---------------------------------------------------------------------------
# API (Phase 1). Names are reserved here; values are filled when the code reads them.
# ---------------------------------------------------------------------------
# Origins allowed to call the API: the admin web page's address (E-05). Comma-separated.
CORS_ORIGINS=http://localhost:5000
# Node environment: development | test | production.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Firebase (first deploy, on the product owner's call only; L109). Left empty until then.
# ---------------------------------------------------------------------------
# The Firebase project ID. Empty means the emulators only.
FIREBASE_PROJECT_ID=
