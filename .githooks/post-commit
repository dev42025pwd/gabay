#!/bin/sh
# Gabay post-commit: puts the real index back in step after a stamped `git commit -- <paths>`.
#
# Incident this prevents: with `git commit -- <paths>` git builds the commit from a TEMPORARY index and
# only afterwards installs the real index, which was computed before pre-commit ran. The version stamp
# lives in the temporary index and the working files, so afterwards HEAD and the working files hold the
# stamp while the real index still holds the old version files, and `git status` shows a staged change
# that REVERSES the stamp. pre-commit records what it stamped in .git/gabay-restage; tools/hooks/
# post-commit.js re-applies it to the real index, keeping anything the developer staged there on purpose
# (resetting the files to HEAD would have thrown that away). For a plain `git commit` it changes nothing.
# It never blocks: git ignores a post-commit exit code, and a failure here only prints a warning.
root=$(git rev-parse --show-toplevel) || exit 0
marker="$(git rev-parse --absolute-git-dir)/gabay-restage"
[ -f "$marker" ] || exit 0
. "$root/.githooks/node.sh"
gabay_node "$root/tools/hooks/post-commit.js" || {
  echo "post-commit: the index was not re-synced (see above); run: git restore --staged app/lib/core/config" >&2
  rm -f "$marker"
}
exit 0
